{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif

  assign color_siblings = product_resource.metafields.custom.color_siblings.value
  assign alignment = block.settings.alignment | default: 'left'
%}

{% if color_siblings != blank and color_siblings.size > 0 %}
  <div
    class="product-color-links product-color-links--{{ alignment }} spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    <fieldset class="product-color-links__fieldset">
      <legend class="visually-hidden">
        {{- 'products.color_variants.label' | t -}}
      </legend>
      <div class="product-color-links__swatches">
        {%- for sibling in color_siblings -%}
          {% liquid
            assign is_current = false
            if sibling.id == product_resource.id
              assign is_current = true
            endif
            assign swatch_color = sibling.metafields.custom.swatch_color.value
          %}
          <a
            href="{{ sibling.url }}"
            class="product-color-links__circle{% if is_current %} product-color-links__circle--active{% endif %}"
            title="{{ sibling.title }}"
            {% if is_current %}aria-current="page"{% endif %}
          >
            {%- if swatch_color != blank -%}
              <span
                class="product-color-links__color"
                style="background: {{ swatch_color }}"
              ></span>
            {%- else -%}
              <span class="product-color-links__color product-color-links__color--empty"></span>
            {%- endif -%}
            <span class="visually-hidden">{{ sibling.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    </fieldset>
  </div>
{% endif %}

{% stylesheet %}
  .product-color-links__fieldset {
    width: 100%;
    border: 0;
    padding: 0;
    margin: 0;
  }

  .product-color-links__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .product-color-links__circle {
    display: block;
    text-decoration: none;
    border-radius: 50%;
    padding: 1.5px;
    border: 1px solid transparent;
    transition: border-color 0.15s ease;
  }

  .product-color-links__circle:hover {
    border-color: rgb(var(--color-foreground-rgb) / 0.4);
  }

  .product-color-links__circle--active {
    border-color: var(--color-foreground);
  }

  .product-color-links__color {
    display: block;
    width: 1em;
    height: 1em;
    border-radius: 50%;
    border: 0.5px solid rgb(var(--color-foreground-rgb) / 0.15);
  }

  .product-color-links__color--empty {
    border-style: dashed;
    border-color: rgb(var(--color-foreground-rgb) / 0.3);
  }

  .product-color-links--center .product-color-links__swatches {
    justify-content: center;
  }

  .product-color-links--right .product-color-links__swatches {
    justify-content: flex-end;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.color_links",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.color_links_info"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.color_links",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
