{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif

  assign color_siblings = product_resource.metafields.custom.color_siblings.value
  assign alignment = block.settings.alignment | default: 'left'
%}

<!-- DEBUG: product={{ product_resource.title }} metafield={{ product_resource.metafields.custom.color_siblings }} siblings_count={{ color_siblings.size }} -->
{% if color_siblings != blank and color_siblings.size > 0 %}
  <div
    class="product-color-links product-color-links--{{ alignment }} spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    <fieldset class="variant-option variant-option--buttons variant-option--swatches product-color-links__fieldset">
      <legend>
        {{- 'products.color_variants.label' | t -}}
        <span class="variant-option__swatch-value">{{ product_resource.title }}</span>
      </legend>
      {%- for sibling in color_siblings -%}
        {% liquid
          assign is_current = false
          if sibling.id == product_resource.id
            assign is_current = true
          endif
          assign swatch_color = sibling.metafields.custom.swatch_color.value
        %}
        <a
          href="{{ sibling.url }}"
          class="variant-option__button-label variant-option__button-label--has-swatch{% if is_current %} product-color-links__swatch--active{% endif %}"
          title="{{ sibling.title }}"
          {% if is_current %}aria-current="page"{% endif %}
        >
          {%- if swatch_color != blank -%}
            <span
              class="swatch swatch--unscaled"
              style="--swatch-background: {{ swatch_color }}"
            ></span>
          {%- else -%}
            <span class="swatch swatch--unscaled swatch--unavailable"></span>
          {%- endif -%}
          <span class="visually-hidden">{{ sibling.title }}</span>
        </a>
      {%- endfor -%}
    </fieldset>
  </div>
{% endif %}

{% stylesheet %}
  .product-color-links__fieldset {
    width: 100%;
  }

  .product-color-links__swatch--active {
    --focus-outline: var(--focus-outline-width) solid var(--color-foreground);
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
    border-radius: var(--variant-picker-swatch-radius);
  }

  .product-color-links--center .product-color-links__fieldset {
    text-align: center;
    justify-content: center;
  }

  .product-color-links--right .product-color-links__fieldset {
    text-align: right;
    justify-content: right;
  }

  .product-color-links a {
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.color_links",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.color_links_info"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.color_links",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
