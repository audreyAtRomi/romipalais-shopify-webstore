<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    <style>
      /* Nova widget — reset floating bar positioning, make inline */
      .bacurr-cur-block {
        position: relative !important;
        bottom: auto !important;
        right: auto !important;
        top: auto !important;
        left: auto !important;
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        width: auto !important;
        min-width: 0 !important;
        height: auto !important;
        display: flex !important;
        align-items: center !important;
        font-family: 'Sohne', sans-serif !important;
        font-size: 12px !important;
        letter-spacing: 0.02em !important;
        color: inherit !important;
        cursor: pointer;
      }

      .bacurr-cur-block * {
        font-family: 'Sohne', sans-serif !important;
        font-size: 12px !important;
        letter-spacing: 0.02em !important;
      }

      /* Nova dropdown — opens upward since it's in the footer */
      .bacurr-dropdown-choices {
        position: absolute !important;
        bottom: calc(100% + 10px) !important;
        top: auto !important;
        right: 0 !important;
        left: auto !important;
        background-color: var(--color-background) !important;
        border: 1px solid rgb(var(--color-foreground-rgb) / 0.2) !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        padding: 8px !important;
        margin: 0 !important;
        z-index: 200 !important;
        min-width: 120px !important;
      }

      /* Nova option items — underline on hover, no background */
      .currMovers {
        background-color: transparent !important;
        padding: 4px 8px !important;
        display: block !important;
      }

      .currMovers:hover {
        background-color: transparent !important;
        text-decoration: underline !important;
        text-underline-offset: 4px !important;
      }

      /* Hide countryContainer in dropdown options, keep only in trigger */
      .currMovers .countryContainer {
        display: none !important;
      }

      /* Trigger button — flex so we can push chevron to the right */
      .bacurr-choiceDesign {
        display: inline-flex !important;
        align-items: center !important;
      }

      /* Move trigger's countryContainer to the right of the currency text */
      .bacurr-choiceDesign .countryContainer {
        order: 2 !important;
        display: inline-flex !important;
        align-items: center !important;
        margin-left: 5px !important;
      }

      .bacurr-choiceDesign .countryContainer img {
        display: none !important;
      }

      /* Our chevron — only on trigger's countryContainer */
      /* Points up at rest (dropdown opens upward), down when open */
      .bacurr-choiceDesign .countryContainer::after {
        content: '' !important;
        display: inline-block !important;
        width: 5px !important;
        height: 5px !important;
        border-right: 1.5px solid #016FB6 !important;
        border-bottom: 1.5px solid #016FB6 !important;
        transform: rotate(-135deg) !important;
        margin-bottom: -2px !important;
        transition: transform 0.3s ease !important;
      }

      /* Rotate chevron downward when dropdown is open */
      .bacurr-choiceDesign.active .countryContainer::after,
      .bacurr-cur-block.active .countryContainer::after {
        transform: rotate(45deg) !important;
        margin-bottom: 2px !important;
      }

      /* Remove dividers between options */
      .baDropdownStyle .bacurr-dropdown-choices li {
        border: none !important;
        border-top: none !important;
        border-bottom: none !important;
      }

      .baDropdownStyle .bacurr-dropdownChoices span {
        margin: 0 !important;
      }

      /* Blue color for selected currency text and arrow */
      div.bacurr-dropdownChoices {
        --bacurrSelect-color: #016FB6;
      }

      /* Hide Nova's original arrow */
      .baDropdownStyle .bacurr-choiceDesign:after {
        display: none !important;
      }

      /* Hide the built-in Shopify currency/language selector in the header */
      dropdown-localization-component {
        display: none !important;
      }
</style>
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height and menu style calculations to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerTopRow = header.querySelector('.header__row--top');
        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        if (headerTopRow) {
          window.requestAnimationFrame(function () {
            document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
          });
        }

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();

      (function setHeaderMenuStyle() {
        const headerComponent = document.querySelector('#header-component');
        if (headerComponent) {
          const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
          const overflowList = headerComponent?.querySelector('overflow-list');
          const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
          headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
        }
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    <script>
      (function () {
        function moveNovaToFooter() {
          var nova = document.querySelector('.bacurr-cur-block');
          var socialWrapper = document.querySelector('.footer-utilities .social-icons__wrapper');
          if (!nova || !socialWrapper) return false;
          // Insert before the first social icon so Nova appears on the left
          var firstIcon = socialWrapper.firstElementChild;
          if (nova.parentNode !== socialWrapper || nova !== socialWrapper.firstElementChild) {
            socialWrapper.insertBefore(nova, firstIcon);
          }
          return true;
        }

        function fixNovaSelectColor() {
          var el = document.querySelector('.bacurr-dropdownChoices');
          if (!el) return;
          el.style.setProperty('--bacurrSelect-color', '#016FB6', 'important');
          // Watch for Nova re-setting the style attribute on this element
          new MutationObserver(function () {
            if (el.style.getPropertyValue('--bacurrSelect-color') !== '#016FB6') {
              el.style.setProperty('--bacurrSelect-color', '#016FB6', 'important');
            }
          }).observe(el, { attributes: true, attributeFilter: ['style'] });
        }

        // Keep watching persistently — Nova re-appends and re-styles on resize
        var footerObserver = new MutationObserver(function () {
          moveNovaToFooter();
          fixNovaSelectColor();
        });
        footerObserver.observe(document.body, { childList: true, subtree: true });
        moveNovaToFooter();
        fixNovaSelectColor();

        // Re-apply Nova currency conversion after variant update resets prices
        document.addEventListener('variant:update', function () {
          setTimeout(function () {
            var trigger = document.querySelector('.bacurr-choiceDesign');
            if (!trigger) return;
            var currentCode = trigger.innerText.trim();
            var options = document.querySelectorAll('.currMovers');
            for (var i = 0; i < options.length; i++) {
              if (options[i].innerText.trim().indexOf(currentCode) !== -1) {
                options[i].click();
                break;
              }
            }
          }, 150);
        });
      })();
    </script>
  </body>
</html>
