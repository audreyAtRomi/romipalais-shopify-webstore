{%- doc -%}
  Size guide tables per product type.
  Add new product types as needed.

  @param {string} product_type - The product type
{%- enddoc -%}

{%- case product_type -%}
  {%- when 'Tops' -%}
    <table>
      <thead>
        <tr>
          <th>Size</th>
          <th>Bust</th>
          <th>Length</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>XS</td><td>32"</td><td>22"</td></tr>
        <tr><td>S</td><td>34"</td><td>23"</td></tr>
        <tr><td>M</td><td>36"</td><td>24"</td></tr>
        <tr><td>L</td><td>38"</td><td>25"</td></tr>
      </tbody>
    </table>

  {%- when 'Bottoms', 'Pants', 'Jeans' -%}
    <table>
      <thead>
        <tr>
          <th>Size</th>
          <th>Waist</th>
          <th>Hip</th>
          <th>Inseam</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>XS</td><td>24"</td><td>34"</td><td>30"</td></tr>
        <tr><td>S</td><td>26"</td><td>36"</td><td>30"</td></tr>
        <tr><td>M</td><td>28"</td><td>38"</td><td>30"</td></tr>
        <tr><td>L</td><td>30"</td><td>40"</td><td>30"</td></tr>
      </tbody>
    </table>

  {%- when 'Dresses', 'Skirts' -%}
    <table>
      <thead>
        <tr>
          <th>Size</th>
          <th>Bust</th>
          <th>Waist</th>
          <th>Hip</th>
          <th>Length</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>XS</td><td>32"</td><td>24"</td><td>34"</td><td>36"</td></tr>
        <tr><td>S</td><td>34"</td><td>26"</td><td>36"</td><td>37"</td></tr>
        <tr><td>M</td><td>36"</td><td>28"</td><td>38"</td><td>38"</td></tr>
        <tr><td>L</td><td>38"</td><td>30"</td><td>40"</td><td>39"</td></tr>
      </tbody>
    </table>

{%- endcase -%}
