{%- doc -%}
  Renders product measurement table based on product type.
  Reads comma-separated values from metafields per measurement.

  @param {object} product - The product object
{%- enddoc -%}

{% liquid
  assign type = product.type | downcase
  assign category = product.category.name | downcase | default: ''
  assign sizes = 'XS,S,M,L' | split: ','

  assign headers = nil
  assign fields = nil

  if type contains 'top' or type contains 'shirt' or type contains 'blouse' or category contains 'top' or category contains 'shirt'
    assign headers = 'Bust,Waist,Length' | split: ','
    assign fields = 'bust,waist,length' | split: ','
  elsif type contains 'pant' or type contains 'jean' or category contains 'pant' or category contains 'jean'
    assign headers = 'Low waist,Rise,Hip,Inseam' | split: ','
    assign fields = 'waist,rise,hip,inseam' | split: ','
  elsif type contains 'dress' or category contains 'dress'
    assign headers = 'Bust,Waist,Hip,Length' | split: ','
    assign fields = 'bust,waist,hip,length' | split: ','
  elsif type contains 'skirt' or category contains 'skirt'
    assign headers = 'Low waist,Hip,Length' | split: ','
    assign fields = 'waist,hip,length' | split: ','
  endif
%}

{% if fields != blank %}
  {% comment %} Collect all measurement values {% endcomment %}
  {% assign has_data = false %}
  {% assign all_values = '' %}
  {% for field in fields %}
    {% assign meta_key = 'measurement_' | append: field %}
    {% assign meta_value = product.metafields.custom[meta_key].value | default: '' %}
    {% if meta_value != '' %}
      {% assign has_data = true %}
    {% endif %}
    {% assign all_values = all_values | append: meta_value | append: '|' %}
  {% endfor %}

  {% if has_data %}
    <table>
      <thead>
        <tr>
          <th>Size</th>
          {% for header in headers %}
            <th>{{ header }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for size in sizes %}
          <tr>
            <td>{{ size }}</td>
            {% assign values_array = all_values | split: '|' %}
            {% for field in fields %}
              {% assign field_values = values_array[forloop.index0] | split: ',' %}
              <td>{{ field_values[forloop.parentloop.index0] | strip | default: '-' }}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
{% endif %}
