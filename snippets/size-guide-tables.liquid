{%- doc -%}
  Renders product measurement table based on product type.
  Reads comma-separated values from metafields per measurement.

  @param {object} product - The product object
{%- enddoc -%}

{% liquid
  assign type = product.type | downcase
  assign sizes = 'XS,S,M,L' | split: ','

  case type
    when 'tops', 'top'
      assign headers = 'Bust,Length' | split: ','
      assign fields = 'bust,length' | split: ','
    when 'pants', 'jeans', 'pant'
      assign headers = 'Waist,Rise,Hip,Inseam' | split: ','
      assign fields = 'waist,rise,hip,inseam' | split: ','
    when 'dress', 'dresses'
      assign headers = 'Bust,Waist,Hip,Length' | split: ','
      assign fields = 'bust,waist,hip,length' | split: ','
    when 'skirt', 'skirts'
      assign headers = 'Waist,Hip,Length' | split: ','
      assign fields = 'waist,hip,length' | split: ','
    else
      assign headers = nil
      assign fields = nil
  endcase
%}

{% if fields != blank %}
  {% comment %} Collect all measurement values {% endcomment %}
  {% assign has_data = false %}
  {% assign all_values = '' %}
  {% for field in fields %}
    {% assign meta_key = 'measurement_' | append: field %}
    {% assign meta_value = product.metafields.custom[meta_key].value | default: '' %}
    {% if meta_value != '' %}
      {% assign has_data = true %}
    {% endif %}
    {% assign all_values = all_values | append: meta_value | append: '|' %}
  {% endfor %}

  {% if has_data %}
    <table>
      <thead>
        <tr>
          <th>Size</th>
          {% for header in headers %}
            <th>{{ header }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for size in sizes %}
          <tr>
            <td>{{ size }}</td>
            {% assign values_array = all_values | split: '|' %}
            {% for field in fields %}
              {% assign field_values = values_array[forloop.index0] | split: ',' %}
              <td>{{ field_values[forloop.parentloop.index0] | strip | default: '-' }}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
{% endif %}
